# Conversio Frontend Environment Configuration

# API Adapter ("http" to connect to Express backend, "supabase", or "mock")
VITE_API_ADAPTER=http
VITE_API_BASE_URL=http://localhost:3001

# Meta WhatsApp Embedded Signup Configuration
VITE_META_APP_ID=your_meta_app_id_here
VITE_META_CONFIG_ID=your_meta_embedded_signup_config_id_here

# Optional Supabase integration (if using Supabase adapter)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
