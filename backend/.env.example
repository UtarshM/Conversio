# Conversio Backend Environment Variables

PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database (Postgres / SQLite connection string)
DATABASE_URL="file:./dev.db"

# Redis Queue Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Meta WhatsApp Cloud API Credentials
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=conversio_webhook_verify_secret
META_GRAPH_VERSION=v22.0

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI LLM Provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Feature Flags
FEATURE_WEBHOOK_SIGNATURE=true
FEATURE_WEBHOOK_DEDUP=true
FEATURE_WEBHOOK_LOGGING=true
FEATURE_CAMPAIGN_QUEUE=true
FEATURE_AUTOMATIC_RETRY=true
